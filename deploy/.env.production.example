AUTH_SECRET=
NEXT_PUBLIC_SITE_URL=
BLOG_MANAGEMENT_API_TOKEN=
BLOG_MANAGEMENT_RATE_LIMIT=120
# Separate token for Hermes private-note operations. Never reuse the general management token.
BLOG_PRIVATE_NOTES_API_TOKEN=
APP_IMAGE=newblog-app:1.6.9
NGINX_PORT=8080
NGINX_SSL_PORT=8443

# Required for reader email verification codes.
# Port 465 normally uses SMTP_SECURE=true; port 587 normally uses false.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_REQUIRE_TLS=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=读写札记 <no-reply@example.com>
SMTP_REPLY_TO=

# Host-side scheduled notifications: email is the primary channel.
# Keep this recipient in the root-only systemd environment, not in git.
PROACTIVE_EMAIL_TO=
# Optional override; defaults to deploy/.env.production.
PROACTIVE_EMAIL_ENV_FILE=
PROACTIVE_EMAIL_TIMEOUT_SECONDS=30
PROACTIVE_EMAIL_MAX_ATTEMPTS=3
PROACTIVE_EMAIL_RETRY_SECONDS=20

# Local Mailpit only: start with `docker compose --profile local-mail up -d`.
# SMTP_HOST=mailpit
# SMTP_PORT=1025
# SMTP_SECURE=false
# SMTP_REQUIRE_TLS=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=读写札记 <no-reply@local.test>
# MAILPIT_WEB_PORT=8025

# Optional: WeRead official Skill API Key, format wrk-...
WEREAD_API_KEY=
WEREAD_SYNC_PROGRESS_LIMIT=80
WEREAD_SYNC_DETAIL_LIMIT=80
WEREAD_SYNC_HIGHLIGHTS=0
WEREAD_SYNC_HIGHLIGHT_BOOK_LIMIT=30
WEREAD_SYNC_REVIEW_PAGE_LIMIT=3
WEREAD_SYNC_REVIEW_PAGE_SIZE=20

# Optional: Steam Web API connection for the public game archive.
# Create a key at https://steamcommunity.com/dev/apikey.
STEAM_WEB_API_KEY=
STEAM_ID64=
STEAM_API_LANGUAGE=schinese
STEAM_API_MAX_ATTEMPTS=4
# Optional comma-separated IPv4 fallback edges. Leave blank to use system DNS;
# fixed CDN addresses can become stale and should only be used as temporary fallbacks.
STEAM_API_RESOLVE_IPS=
STEAM_SYNC_TIMEOUT_SECONDS=300
