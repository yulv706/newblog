[Unit]
Description=Synchronize the newblog Steam game archive
Wants=docker.service network-online.target
After=docker.service network-online.target
StartLimitIntervalSec=45min
StartLimitBurst=4

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/workspace/newblog
ExecStart=/root/workspace/newblog/deploy/sync-steam.sh
TimeoutStartSec=6min
Restart=on-failure
RestartSec=10min
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
