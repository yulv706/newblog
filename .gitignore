# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files and local credentials
.env
.env.*
!.env.example
!.env.*.example
.env*.local
/deploy/.env.production

# local operator notes and personal working material
/work/
/SERVER_OPERATIONS.md
/server-operations.md

# certificates and private keys
/certs/*
!/certs/.gitignore
*.key
*.crt
*.cer
*.csr
*.p12
*.pfx

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# database
/data/*.db
/data/*.db-wal
/data/*.db-shm
/data/*.db.bak.*
/data/system-health.json
/data/backups/

# uploads (user content)
/public/uploads/images/*
!/public/uploads/images/.gitkeep
/public/uploads/daily/*
!/public/uploads/daily/.gitkeep

# Python runtime artifacts
__pycache__/
*.py[cod]

# agent-only project scaffolding and research
/.factory/
.factory/research/
